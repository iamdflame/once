# Names only. Real values live in app/.env.local (never committed); Stripe Projects writes most of them.

# Stripe test sandbox (restricted key: Checkout Sessions + PaymentIntents). Test mode only; live keys are refused.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# CreateOS sandbox key, provisioned by Stripe Projects (passed to the SDK explicitly).
CREATEOS_PROJECT_API_KEY=
# The CreateOS platform API, written by Stripe Projects. NOT the Sandbox API; the host does not use it as the SDK base URL.
CREATEOS_PROJECT_API_URL=
# Optional: override the Sandbox API base URL (default https://api.sb.createos.sh).
# CREATEOS_SANDBOX_BASE_URL=

# Model for the agent loop. Anthropic wins when set; otherwise OpenRouter free models.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
OPENROUTER_API_API_KEY=
# OPENROUTER_MODELS=poolside/laguna-s-2.1:free,cohere/north-mini-code:free

# Optional: talk to a local world instead of CreateOS (e.g. http://127.0.0.1:8080).
# WORLD_URL=
# Optional: path of the world bundle to upload (default ../world/dist/world.cjs).
# WORLD_BUNDLE=
